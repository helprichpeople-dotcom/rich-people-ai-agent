{
  "name": "rich-people-ai-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test:sheets": "tsx src/test-sheets.ts",
    "test:grok": "tsx src/test-grok.ts",
    "test:media": "tsx src/test-media.ts",
    "test:image": "tsx src/test-image-match.ts",
    "test:handoff": "tsx src/test-handoff.ts",
    "test:dedupe": "tsx src/test-media-dedupe.ts",
    "test:product": "tsx src/test-product.ts",
    "test:all": "tsc --noEmit && npm run -s test:media && npm run -s test:image && npm run -s test:handoff && npm run -s test:dedupe && npm run -s test:product",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.10",
    "@types/pngjs": "^6.0.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "googleapis": "^144.0.0",
    "jpeg-js": "^0.4.4",
    "openai": "^4.77.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": "20.x"
  }
}
